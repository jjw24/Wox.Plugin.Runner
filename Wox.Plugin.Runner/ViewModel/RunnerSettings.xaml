<UserControl
    x:Class="Wox.Plugin.Runner.ViewModel.RunnerSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infra="clr-namespace:Wox.Plugin.Runner.Infrastructure"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Wox.Plugin.Runner.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:RunnerSettingsViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Wox.Plugin.Runner;component/Resources/FluentStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <infra:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <infra:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16" Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="{DynamicResource Color05B}"
            Text="Plugin Runner Commands" />

        <!-- Instructions with unsaved changes indicator -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12" Orientation="Horizontal">
            <TextBlock
                Foreground="{DynamicResource Color04B}"
                Text="Manage your command shortcuts. Click a command to edit it."
                TextWrapping="Wrap" />
            <TextBlock
                Margin="8,0,0,0"
                FontWeight="SemiBold"
                Foreground="{StaticResource WarningBrush}"
                Text="● Unsaved changes"
                Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Command List -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search Box -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBox
                        x:Name="SearchBox"
                        Style="{StaticResource SearchTextBox}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Resources>
                            <Style TargetType="TextBox" BasedOn="{StaticResource SearchTextBox}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock
                                                            Margin="32,0,0,0"
                                                            Foreground="{DynamicResource Color08B}"
                                                            Text="Search commands..." />
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Path
                        Width="16"
                        Height="16"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                        Fill="{DynamicResource Color08B}"
                        IsHitTestVisible="False"
                        Stretch="Uniform" />
                </Grid>

                <!-- Commands ListBox -->
                <ListBox
                    x:Name="LbxCommands"
                    Grid.Row="1"
                    MaxHeight="500"
                    ScrollViewer.CanContentScroll="False"
                    ItemContainerStyle="{StaticResource FluentListBoxItem}"
                    ItemsSource="{Binding FilteredCommands}"
                    SelectedItem="{Binding SelectedCommand}"
                    Style="{StaticResource FluentListBox}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <!-- Description with dirty indicator -->
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Color05B}"
                                    Text="{Binding DisplayText}"
                                    TextTrimming="CharacterEllipsis" />

                                <!-- Shortcut Badge -->
                                <Border
                                    Margin="0,4,0,0"
                                    Padding="6,2"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="3">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding Shortcut}" />
                                </Border>

                                <!-- Path Preview -->
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource Color04B}"
                                    Text="{Binding Path}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Path}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Action Buttons -->
                <StackPanel
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    Orientation="Horizontal">
                    <Button
                        Width="80"
                        Margin="0,0,8,0"
                        Click="btnAdd_Click"
                        Content="Add"
                        Style="{StaticResource FluentButton}" />
                    <Button
                        Width="80"
                        Margin="0,0,8,0"
                        Click="BntDelete"
                        Content="Delete"
                        IsEnabled="{Binding CommandIsSelected}"
                        Style="{StaticResource FluentSecondaryButton}" />
                    <Button
                        Width="80"
                        Click="btnSaveChanges_Click"
                        Content="Save"
                        IsEnabled="{Binding HasUnsavedChanges}"
                        Style="{StaticResource FluentButton}" />
                </StackPanel>
            </Grid>

            <!-- Right Panel: Command Details -->
            <StackPanel
                Grid.Column="2"
                Margin="4"
                Visibility="{Binding SelectedCommand, Converter={StaticResource NullToVisibilityConverter}}">
                <!-- Basic Information Section -->
                <GroupBox Header="Basic Information" Style="{StaticResource FluentGroupBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Description -->
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Content="Description:"
                            Foreground="{DynamicResource Color04B}" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,12"
                            Style="{StaticResource FluentTextBox}"
                            Text="{Binding SelectedCommand.Description, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Shortcut -->
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Content="Shortcut:*"
                            Foreground="{DynamicResource Color04B}" />
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBox
                                Margin="0,0,0,4"
                                Text="{Binding SelectedCommand.Shortcut, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource FluentTextBox}" TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCommand.Shortcut}" Value="">
                                                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource ErrorBrush}"
                                Text="⚠ Shortcut is required"
                                Visibility="{Binding SelectedCommand.Shortcut, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Execution Settings Section -->
                <GroupBox Header="Execution Settings" Style="{StaticResource FluentGroupBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Path -->
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Content="Path:*"
                            Foreground="{DynamicResource Color04B}" />
                        <Grid Grid.Row="0" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="TbPath"
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                Text="{Binding SelectedCommand.Path, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource FluentTextBox}" TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCommand.Path}" Value="">
                                                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button
                                Grid.Column="1"
                                Click="btnBrowsePath_Click"
                                Content="Browse"
                                Style="{StaticResource FluentSecondaryButton}" />
                        </Grid>

                        <!-- Path Error Message -->
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{StaticResource ErrorBrush}"
                            Text="⚠ Path is required"
                            Visibility="{Binding SelectedCommand.Path, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />

                        <!-- Working Directory -->
                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,12,0,0"
                            VerticalAlignment="Center"
                            Content="Working Dir:"
                            Foreground="{DynamicResource Color04B}" />
                        <Grid
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="TbWorkDir"
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                Style="{StaticResource FluentTextBox}"
                                Text="{Binding SelectedCommand.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Click="btnBrowseWorkDir_Click"
                                Content="Browse"
                                Style="{StaticResource FluentSecondaryButton}" />
                        </Grid>

                        <!-- Working Directory Help -->
                        <Expander
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,8,0,0"
                            Header="Working Directory Help"
                            Style="{StaticResource FluentExpander}">
                            <TextBlock
                                Margin="4"
                                FontSize="12"
                                Foreground="{DynamicResource Color04B}"
                                Text="Use {explorer} to use the currently open file explorer window's path as the working directory."
                                TextWrapping="Wrap" />
                        </Expander>

                        <!-- Run as Administrator -->
                        <CheckBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="0,12,0,0"
                            Content="Run as Administrator"
                            IsChecked="{Binding SelectedCommand.RunAsAdministrator, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource FluentCheckBox}"
                            ToolTip="Requires User Account Control (UAC) elevation" />
                    </Grid>
                </GroupBox>

                <!-- Advanced Settings Section -->
                <GroupBox Header="Advanced Settings" Style="{StaticResource FluentGroupBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Arguments -->
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Content="Arguments:"
                            Foreground="{DynamicResource Color04B}" />
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBox
                                Margin="0,0,0,8"
                                Style="{StaticResource FluentTextBox}"
                                Text="{Binding SelectedCommand.ArgumentsFormat, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Arguments Help Expander -->
                            <Expander Header="Arguments Syntax Help" Style="{StaticResource FluentExpander}">
                                <StackPanel Margin="4">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource Color04B}"
                                        Text="• Use {*} to allow infinite arguments from the query"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Color04B}"
                                        Text="• Use {0}, {1}, {2}... for positional arguments ({0} is the first argument)"
                                        TextWrapping="Wrap" />
                                    <Border
                                        Margin="0,8,0,0"
                                        Padding="8"
                                        Background="{DynamicResource Color07B}"
                                        CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="{DynamicResource Color04B}"
                                                Text="Example:" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="{DynamicResource Color05B}"
                                                Text="Arguments: -h {0} -p {1}" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="{DynamicResource Color05B}"
                                                Text="Query: r myshortcut arg1 22" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource AccentBrush}"
                                                Text="Result: -h arg1 -p 22" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>